{
  "name": "ladon-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test ../shared/*.test.ts src/*.test.ts",
    "package": "LADON_API_URL=https://ladon-api.vercel.app node build.mjs && rm -f ladon-extension.zip && cd dist && zip -qr ../ladon-extension.zip ."
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "posthog-js": "^1.434.15"
  }
}
