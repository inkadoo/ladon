# Copy to .env and fill in. Never commit .env.

# Helius API key (free tier is enough): https://helius.dev
HELIUS_API_KEY=

# Supabase Postgres connection string (Project settings > Database)
DATABASE_URL=

# Random secret used to pseudonymise reporters for rate limiting and de-duplication.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REPORTER_SALT=

# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:3000

# Optional: verified X quests. Create an OAuth 2.0 Web App with read-only scopes.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://getladon.vercel.app/airdrop
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRDROP_ENCRYPTION_KEY=
